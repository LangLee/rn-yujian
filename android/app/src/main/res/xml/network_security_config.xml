<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- 开发期简单绕过：后端 https://81.71.1.11 为自签证书，且 9001 端口 MinIO 媒体走明文 HTTP。 -->
    <!-- 自签证书打包在 res/raw/yujian_server.crt，在 base-config 全局信任， -->
    <!-- 避免 IP 地址写在 <domain> 里时 domain-config 匹配不生效的问题。 -->
    <!-- 上架前应换成正式域名 + 受信证书，并恢复按域名收紧的严格配置。 -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
            <certificates src="@raw/yujian_server" />
        </trust-anchors>
    </base-config>
</network-security-config>
